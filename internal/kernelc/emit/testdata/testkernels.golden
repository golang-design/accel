// subgroupReduceFallbackFlat is the generated flat lowering of SubgroupReduceFallback.
//
// It is what the CPU backend runs. The authored SubgroupReduceFallback is never registered as
// an executable: it supplies the typed source this was built from, and it is
// run only by the test that checks the two agree.
func subgroupReduceFallbackFlat(t accel.Thread, in []float32, out []float32, width []uint32) {
	var lid uint32 = t.LocalID().X
	var gid uint32 = t.GlobalID().X
	var w uint32 = width[int32(0)]
	var sid uint32 = (lid / w)
	var lane uint32 = (lid % w)
	if lane == uint32(0) {
		var acc float32 = float32(0)
		{
			var l uint32 = uint32(0)
			for ; l < w; l = (l + uint32(1)) {
				var idx uint32 = ((gid - lane) + l)
				if idx < uint32(int32(len(in))) {
					acc = float32(acc + in[idx])
				}
			}
		}
		if sid < uint32(int32(len(out))) {
			out[sid] = acc
		}
	}
}

