`,
	Caps:        17,
	Suspensions: 2,
	Cooperative: func(t accel.Thread, a accel.KernelArgs, slot *accel.KernelFrame) bool {
		f, _ := slot.State.(*subgroupReduceFrame)
		if f == nil {
			f = &subgroupReduceFrame{}
			slot.State = f
		}
		return subgroupReduceCoop(t, accel.KernelSlice[float32](a, 0), accel.KernelSlice[float32](a, 1), f, slot, slot.Shared)
