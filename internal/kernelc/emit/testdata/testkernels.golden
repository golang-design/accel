// subgroupReduceFrame is one invocation's saved state between suspension points.
//
// Every local lives here rather than only those live across a barrier: that
// is a superset of the right answer and therefore correct, and a liveness
// analysis can shrink it later without changing anything a caller sees.
type subgroupReduceFrame struct {
	pc       int
	gid0     uint32
	v1       float32
	total2   float32
	elected3 bool
	sid4     uint32
}

// subgroupReduceCoop runs one invocation of SubgroupReduce to its next suspension point.
//
// It reports whether the invocation suspended. False means it finished, and
// the scheduler stops calling it. Each case is one state; the assignment to
// pc before continuing is the jump, which is explicit because a loop's states
// do not run in numeric order.
func subgroupReduceCoop(t accel.Thread, in []float32, out []float32, f *subgroupReduceFrame, frame *accel.KernelFrame, tr *accel.KernelSharedTracker) bool {
	for {
		switch f.pc {
		case 0:
			f.gid0 = t.GlobalID().X
			f.v1 = float32(0)
			if f.gid0 < uint32(int32(len(in))) {
				f.v1 = in[f.gid0]
			}
			f.pc = 1
			continue
		case 1:
			frame.Sub = accel.KernelSubAddF32
			frame.SubF32 = f.v1
			f.pc = 2
			frame.Barrier = accel.KernelBarrierID{Index: 1, Pos: ""}
			return true
		case 2:
			f.total2 = frame.SubF32
			f.pc = 3
			continue
		case 3:
			frame.Sub = accel.KernelSubElect
			f.pc = 4
			frame.Barrier = accel.KernelBarrierID{Index: 3, Pos: ""}
			return true
		case 4:
			f.elected3 = frame.SubBool
			f.pc = 5
			continue
		case 5:
			if f.elected3 {
				f.sid4 = t.SubgroupID()
				if f.sid4 < uint32(int32(len(out))) {
					out[f.sid4] = f.total2
				}
			}
			return false
		}
		return false
	}
}

